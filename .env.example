# Root .env — consumed by docker-compose.yml's variable interpolation
# (${VAR} references). Copy to .env and fill in real values before running
# `docker compose up`. This is separate from backend/.env.example and
# frontend/.env.local.example, which matter when running each service
# outside Docker (e.g. `uvicorn` directly during backend-only development).

ENVIRONMENT=local

POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind

# Generate real values for anything below marked "required" before any
# non-local deployment — docker-compose.yml's ${VAR:?message} syntax will
# refuse to start without JWT_SECRET_KEY/ENCRYPTION_KEY being set at all,
# and app/core/config.py's production validator additionally refuses to
# boot with the placeholder default when ENVIRONMENT=production.

# required: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV

# required: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_IN_ENV_FERNET_KEY_MUST_BE_32B64B

# required for AI features to work at all
OPENAI_API_KEY=

# required for GitHub OAuth login and private repo cloning
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# local | s3 -- see DEPLOYMENT.md for S3 setup
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_REGION=us-east-1

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
