ENVIRONMENT=local

# Database
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docmind

# Redis (Celery broker/backend + rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT — generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_ENV

# GitHub OAuth (Step 8)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# LLM provider (Step 7)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5

# Vector store (Step 9)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=docmind_embeddings

# File storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/var/docmind/storage
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=10

# CORS (comma-separated list is NOT supported by pydantic-settings list
# parsing from plain env vars automatically — see note in Step 11 on using
# a JSON-array string here, e.g. '["http://localhost:3000"]')
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
